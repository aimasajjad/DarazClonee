<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopPK</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            .navbar { background: #f57224 !important; }
            .product-card img { height: 180px; object-fit: cover; }
            .product-card:hover { box-shadow: 0 4px 15px rgba(0,0,0,0.1); transform: translateY(-2px); transition: all 0.2s; }
            .btn-orange { background: #f57224; color: white; border: none; }
            .btn-orange:hover { background: #e06010; color: white; }
            footer { background: #f57224; color: white; margin-top: 60px; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand text-white fw-bold fs-4"
               asp-controller="Home" asp-action="Index">
                🛒 ShopPK
            </a>

            <!-- Search Bar -->
            <form asp-controller="Products" asp-action="Index"
                  method="get" class="d-flex flex-grow-1 mx-3">
                <input name="search"
                       class="form-control me-2"
                       placeholder="Search products..." />
                <button class="btn btn-light">Search</button>
            </form>

            <!-- Cart & Login -->
            <div class="d-flex align-items-center gap-2">

                <a asp-controller="Cart" asp-action="Index"
                   class="btn btn-outline-light">
                    🛒 Cart
                </a>

                <a asp-controller="Admin" asp-action="Index"s
                   class="btn btn-light btn-sm">
                    ⚙️ Admin
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="text-white small">
                        👤 @User.Identity.Name
                    </span>
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-outline-light btn-sm">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Identity/Account/Login"
                       class="btn btn-light btn-sm">
                        Login
                    </a>
                    <a href="/Identity/Account/Register"
                       class="btn btn-outline-light btn-sm">
                        Register
                    </a>
                }

            </div>

        </div>
    </nav>

    <!-- Page Content -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0">© 2025 ShopPK — Built with ASP.NET Core</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>