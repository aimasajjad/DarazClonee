@model DarazClone.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Home</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Products" asp-action="Index">Products</a>
        </li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row">

    <!-- Image -->
    <div class="col-md-5 mb-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 class="card-img-top"
                 style="height:180px;object-fit:cover"
                 alt="@Model.Name"
                 onerror="this.onerror=null;this.src='https://via.placeholder.com/300x200?text=No+Image'" />
        }
        else
        {
            <div class="bg-light rounded d-flex align-items-center
                justify-content-center"
                 style="height:350px;font-size:80px">
                🛍️
            </div>
        }
    </div>

    <!-- Details -->
    <div class="col-md-7">
        <span class="badge bg-warning text-dark mb-2">
            @Model.Category?.Name
        </span>

        <h2 class="fw-bold">@Model.Name</h2>

        <h3 class="text-danger fw-bold my-3">
            Rs. @Model.Price.ToString("N0")
        </h3>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <hr />

        @if (Model.StockQuantity > 0)
        {
            <p class="text-success fw-bold">
                ✅ In Stock (@Model.StockQuantity available)
            </p>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="d-flex gap-2 align-items-center mb-3">
                    <label class="fw-bold">Quantity:</label>
                    <input type="number"
                           name="qty"
                           value="1"
                           min="1"
                           max="@Model.StockQuantity"
                           class="form-control"
                           style="width:80px" />
                </div>
                <button type="submit" class="btn btn-warning btn-lg px-5">
                    🛒 Add to Cart
                </button>
            </form>
        }
        else
        {
            <p class="text-danger fw-bold">❌ Out of Stock</p>
        }

        <div class="mt-3">
            <a asp-controller="Products" asp-action="Index"
               class="btn btn-outline-secondary">
                ← Back to Products
            </a>
        </div>
    </div>
</div>