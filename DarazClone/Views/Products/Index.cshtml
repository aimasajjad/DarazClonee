@model List<Product>

@{
    ViewData["Title"] = "Products";
}

<!-- Filter Bar -->
<div class="card border-0 shadow-sm p-3 mb-4">
    <form asp-controller="Products" asp-action="Index" method="get">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Search</label>
                <input name="search"
                       class="form-control"
                       placeholder="Search products..."
                       value="@Context.Request.Query["search"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sort By</label>
                <select name="sort" class="form-select">
                    <option value="newest">Newest First</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-orange w-100">
                    Filter
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Results Count -->
<p class="text-muted small mb-3">
    @Model.Count product(s) found
</p>

<!-- Product Grid -->
@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <h4 class="text-muted">No products found</h4>
        <a asp-controller="Products" asp-action="Index"
           class="btn btn-orange mt-3">
            Clear Filters
        </a>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm product-card">

                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl"
                             class="card-img-top"
                             style="height:180px;object-fit:cover"
                             alt="@p.Name"
                             onerror="this.onerror=null;this.style.display='none';
                        this.nextElementSibling.style.display='flex'" />
                        <div class="bg-light d-flex align-items-center
                            justify-content-center"
                             style="height:180px;font-size:48px;display:none!important">
                            🛍️
                        </div>
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center
                            justify-content-center"
                             style="height:180px;font-size:48px">
                            🛍️
                        </div>
                    }

                    <div class="card-body p-2">
                        <span class="badge bg-warning text-dark small mb-1">
                            @p.Category?.Name
                        </span>
                        <p class="small mb-1 text-truncate fw-bold"
                           title="@p.Name">
                            @p.Name
                        </p>
                        <p class="fw-bold text-danger mb-2">
                            Rs. @p.Price.ToString("N0")
                        </p>

                        <div class="d-flex gap-1">
                            <a asp-controller="Products"
                               asp-action="Detail"
                               asp-route-id="@p.Id"
                               class="btn btn-outline-secondary btn-sm">
                                View
                            </a>
                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post"
                                  class="flex-grow-1">
                                <input type="hidden"
                                       name="productId"
                                       value="@p.Id" />
                                <button type="submit"
                                        class="btn btn-warning btn-sm w-100">
                                    Add to Cart
                                </button>
                            </form>
                        </div>

                        @if (p.StockQuantity == 0)
                        {
                            <p class="text-muted small mt-1 mb-0">
                                Out of stock
                            </p>
                        }
                        else if (p.StockQuantity < 5)
                        {
                            <p class="text-danger small mt-1 mb-0">
                                Only @p.StockQuantity left!
                            </p>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}