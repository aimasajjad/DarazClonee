@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as List<DarazClone.Models.CartItem>
               ?? new List<DarazClone.Models.CartItem>();
    decimal total = ViewBag.Total ?? 0;
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <h3 class="fw-bold mb-4">🧾 Checkout</h3>

        @if (cart.Count == 0)
        {
            <div class="text-center py-4">
                <p class="text-muted">Your cart is empty.</p>
                <a asp-controller="Products" asp-action="Index"
                   class="btn btn-orange">Shop Now</a>
            </div>
        }
        else
        {
            <!-- Order Summary -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    @foreach (var item in cart)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.ProductName × @item.Quantity</span>
                            <span class="text-danger fw-bold">
                                Rs. @item.Total.ToString("N0")
                            </span>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span class="text-danger">
                            Rs. @total.ToString("N0")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Shipping Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Shipping Details</h5>

                    <form asp-controller="Orders"
                          asp-action="Checkout"
                          method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Full Name
                            </label>
                            <input type="text"
                                   name="fullName"
                                   class="form-control"
                                   placeholder="Muhammad Ali"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Phone Number
                            </label>
                            <input type="text"
                                   name="phone"
                                   class="form-control"
                                   placeholder="03001234567"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Shipping Address
                            </label>
                            <textarea name="shippingAddress"
                                      class="form-control"
                                      rows="3"
                                      placeholder="House #, Street, City"
                                      required></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-orange w-100 btn-lg">
                            ✅ Place Order
                        </button>

                    </form>
                </div>
            </div>
        }

    </div>
</div>